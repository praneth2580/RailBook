# RailBook environment variables.
# Copy this file to .env and fill in what you need. .env is git-ignored.
# Under `npm run dev` these are loaded from .env; a packaged RailBook reads the real environment.

# A website to keep open beside the app while it runs. The app can read from and act on it through the
# companion-site API (see the README). Any http(s) site except IRCTC: RailBook refuses irctc.co.in and its
# subdomains, as the configured address, on navigation, and inside the page.
RAILBOOK_SITE_URL=https://example.com/

# Show the companion site's browser window (1/true/yes/on), or keep it hidden (anything else, the default).
RAILBOOK_SITE_HEADED=0

# Optional: a Chromium-based browser to use instead of the installed Google Chrome.
# RAILBOOK_CHROME=/usr/bin/google-chrome

# Optional: where RailBook keeps its data (defaults to the per-OS config folder).
# RAILBOOK_DATA_DIR=
