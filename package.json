{
  "name": "railbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "scripts/with-node.sh node scripts/desktop-dev.mjs",
    "build": "tsc --noEmit && tsc -p desktop --noEmit && vite build",
    "test": "scripts/with-node.sh vitest run",
